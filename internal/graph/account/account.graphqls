enum AccountType {
  checking
  debit_card
  savings
  credit_card
  cash
  investment
  other
}

enum Currency {
  USD
  NOK
  UAH
  EUR
}

type Account {
  id: ID!
  name: String!
  accountType: AccountType!
  currency: Currency!
  "Hex like #2a78d6"
  color: String
  isArchived: Boolean!
  "Minor units. Income adds, expense subtracts, transfers move money between accounts"
  balance: Int64! @goField(forceResolver: true)
}

extend type Query {
  account(id: ID!): Account
  accounts(includeArchived: Boolean = false): [Account!]!
}

input CreateAccountInput {
  name: String!
  accountType: AccountType!
  currency: Currency!
  color: String
}

input UpdateAccountInput {
  name: String
  accountType: AccountType
  currency: Currency
  "Empty string clears it"
  color: String
  isArchived: Boolean
}

extend type Mutation {
  createAccount(input: CreateAccountInput!): Account!
  updateAccount(id: ID!, input: UpdateAccountInput!): Account!
  # soft delete: archives the account
  deleteAccount(id: ID!): Boolean!
}
